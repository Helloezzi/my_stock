# Codex should focus on source code and lightweight docs.
# Ignore generated data, caches, editor files, and Python bytecode.

.git/
.vscode/
__pycache__/
*.pyc
*.pyo

.venv/
venv/
env/

# Generated market data and caches
data/cache/
data/daily/
data/scan_cache/
data/_locks/

# Large or generated local data files
data/*.csv
data/*.parquet
data/*.json
data/universe_*.csv
data/*top200*.csv
data/*top500*.csv
data/*all*.csv

# OS noise
.DS_Store
*.log

# Legacy / currently unused code paths
legacy/

# Historical notes / logs
ssh and docker terminal log.txt

# User-facing note with broken encoding; not needed for code tasks
readme.md
